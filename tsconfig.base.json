{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "customConditions": ["@tsviz/source"],
    "noEmit": true,
    "types": ["node"]
  }
}
