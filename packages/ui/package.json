{
  "name": "@tsviz/ui",
  "version": "0.1.0",
  "description": "React components for visualizing a TypeScript declaration graph",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaymcgovern/typescript-visualizer",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@tsviz/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@tsviz/source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json && tsc -p test",
    "test": "vitest run --root ../.. --project ui",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tsviz/graph": "^0.1.0",
    "elkjs": "^0.12.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
